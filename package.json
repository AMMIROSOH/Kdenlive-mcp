{
  "name": "kdenlive-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Headless, MLT-backed video editing foundation for MCP clients",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AMMIROSOH/Kdenlive-mcp.git"
  },
  "homepage": "https://github.com/AMMIROSOH/Kdenlive-mcp#readme",
  "bugs": "https://github.com/AMMIROSOH/Kdenlive-mcp/issues",
  "keywords": [
    "mcp",
    "kdenlive",
    "mlt",
    "video-editing",
    "ffmpeg"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.5.0",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:runtime": "vitest run packages/project-core/src/media.runtime.test.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "capabilities": "pnpm --filter @kdenlive-mcp/runtime-probe probe",
    "spike:prepare": "pnpm --filter @kdenlive-mcp/mlt-spike prepare-fixtures",
    "spike:compile": "pnpm --filter @kdenlive-mcp/mlt-spike compile",
    "spike:render": "pnpm --filter @kdenlive-mcp/mlt-spike render",
    "render:acceptance": "pnpm build && pnpm --filter @kdenlive-mcp/render-core acceptance",
    "mcp:start": "pnpm build && pnpm --filter @kdenlive-mcp/server start",
    "mcp:acceptance": "pnpm build && pnpm --filter @kdenlive-mcp/server acceptance",
    "doctor": "pnpm build && pnpm --filter @kdenlive-mcp/server start -- --doctor",
    "docs:check": "node scripts/verify-docs.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "licenses:report": "node scripts/generate-notices.mjs",
    "package:release": "pnpm build && pnpm licenses:report && node scripts/package-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:acceptance": "node scripts/release-acceptance.mjs",
    "fixtures:milestone-1": "pnpm --filter @kdenlive-mcp/project-core fixtures",
    "worker:check": "python -m pytest apps/analysis-worker && python -m mypy apps/analysis-worker/src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.0.0",
    "fast-check": "^4.8.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.9"
  }
}
